# Frontend build/dev config (Vite reads VITE_* at build time). Copy to
# .env.local for local dev; setup.sh writes .env.production.local for the hosted UI.

# API base path the SPA calls (all requests go through src/api/client.ts).
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api (local dev only). Point at a cloud API host
# to run the frontend locally against cloud services. Defaults to http://localhost:8000.
# VITE_API_PROXY_TARGET=https://your-cloud-api-host

# Dev auth bypass — true for local development (no Cognito needed). Must match the
# backend's DEV_AUTH.
VITE_DEV_AUTH=false

# Cognito Hosted UI (used when VITE_DEV_AUTH=false).
VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REDIRECT_URI=http://localhost:3000

# Read-only demo mode: data stays live, actions that change workflows/portfolio are disabled.
VITE_DEMO_READ_ONLY=false

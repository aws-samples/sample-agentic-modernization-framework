################################################################################
# Terraform Backend — S3 + DynamoDB locking (TARGET account state)
# Generated by AMF Execution Agent
#
# This state lives in the application's TARGET account (${account_id}), not in
# the AMF control-plane account. The operator must create the bucket and lock
# table once before `terraform init` — see README.md ("Bootstrap the state
# backend"). Backend blocks cannot reference variables, so the names are
# rendered by tool_execution from APP_TFSTATE_BUCKET_PATTERN / APP_TFSTATE_LOCK_PATTERN.
################################################################################

terraform {
  backend "s3" {
    bucket         = "${tfstate_bucket}"
    key            = "${app_id}/terraform.tfstate"
    region         = "${region}"
    encrypt        = true
    dynamodb_table = "${tfstate_lock}"
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  required_version = ">= 1.5"
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Application = var.app_id
      ManagedBy   = "amf-terraform"
      Environment = var.environment
    }
  }
}

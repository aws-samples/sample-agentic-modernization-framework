# Container image for {{app_name}} — generated by AMF because the module had no
# Dockerfile. The CodeBuild buildspec builds the jar and copies it to build/app.jar.
# Multi-arch base (x86_64 / arm64): CodeBuild builds natively for the task's
# cpu_architecture. Runs as a non-root user.
FROM public.ecr.aws/amazoncorretto/amazoncorretto:{{java_version}}-al2023

WORKDIR /app
COPY build/app.jar /app/app.jar

USER 10001:10001
EXPOSE {{container_port}}

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fs http://localhost:{{container_port}}{{health_check_path}} || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]

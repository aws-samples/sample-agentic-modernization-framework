# Backend settings (backend/src/config.py). Every value is optional unless noted;
# blanks auto-derive from PROJECT_PREFIX. scripts/setup.sh writes the resolved
# values here from Terraform outputs.

# ── Core ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Project prefix — all AWS resource names derive from this
# (DynamoDB {prefix}_portfolio, S3 {prefix}-data-{account}-{region},
#  ECS {prefix}-cluster, SFN {prefix}-agentcore-workflow, etc.)
PROJECT_PREFIX=amf
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Bedrock model / inference profile used by the AgentCore Harness + worker synthesis.
# Must be an inference profile enabled in your account/region.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Leave blank to auto-derive from PROJECT_PREFIX (recommended).
DYNAMODB_TABLE=
S3_BUCKET=
SFN_STATE_MACHINE_NAME=
# Full ARN override; blank = built from the caller account + SFN_STATE_MACHINE_NAME.
SFN_STATE_MACHINE_ARN=
ECS_LOG_GROUP=

# ── AgentCore (Harness + MCP Gateway) — populated by setup.sh ────────────
AGENTCORE_GATEWAY_ID=
AGENTCORE_GATEWAY_URL=
# Harness ARN (Terraform output harness_arn). AGENTCORE_RUNTIME_ARN is accepted as a legacy alias.
AGENTCORE_HARNESS_ARN=
# Lambda bridge that invokes the Harness (auto: {prefix}-invoke-runtime)
AGENTCORE_INVOKE_LAMBDA=

# ── ATX worker (ECS Fargate) ─────────────────────────────────────────────
# Provisioned by Terraform; override only if needed.
ATX_SHELL_TIMEOUT=36000
ATX_CODE_ANALYSIS_TD_NAME=AWS/comprehensive-codebase-analysis
ATX_ECS_CLUSTER=
ASSESSMENT_ECS_TASK_DEFINITION=

# Source repos are AWS CodeCommit only (cloned with the AWS credential helper; no Git token).
GIT_USER_EMAIL=atx-runner@migration-framework.local
GIT_USER_NAME="ATX Runner"

# ── API / auth ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# Dev auth bypass — true only for local development (no Cognito).
# NEVER enable outside local dev. The UAT deploy sets false + the Cognito ids.
DEV_AUTH=true
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# ── Graph / wave planning ────────────────────────────────────────────────
#   dynamodb = derive the dependency graph from the portfolio table (default, no extra infra)
#   none     = wave planning disabled
GRAPH_BACKEND=dynamodb

# ── Tunables (defaults shown; uncomment to override) ─────────────────────
# DEV_TOKEN_TTL_SECONDS=86400
# JWKS_CACHE_TTL_SECONDS=3600
# HTTP_TIMEOUT_SECONDS=10
# BEDROCK_READ_TIMEOUT=600
# BEDROCK_CONNECT_TIMEOUT=10
# BEDROCK_MAX_ATTEMPTS=3
# SYNTHESIS_MAX_TOKENS=4096
# SYNTHESIS_TEMPERATURE=0.3
# TERRAFORM_CMD_TIMEOUT_SECONDS=900
# STRATEGY_CONFIDENCE_FLOOR=40
# APPROVAL_AGING_HOURS=48
# SCHEDULE_RISK_WARN_DAYS=90
# CHAT_HISTORY_MAX_MESSAGES=40
# WAVE_PILOT_MAX_SCORE=3
# WAVE_EARLY_MAX_SCORE=8
# WAVE_PILOT_SIZE=3
# WAVE_BAND_LIMITS=3,8,12,10
# GRAPH_MAX_MACHINES=2000
